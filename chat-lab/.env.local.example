COZE_API_BASE_URL=http://localhost:8001
# 服务端私密 token，不能使用 NEXT_PUBLIC_ 前缀。
COZE_API_TOKEN=
# 可选：后端 devbox 冷启动时，代理层自动重试次数。
COZE_COLD_START_RETRIES=4

# 新版后端代理地址（前端实际调用）
DIAGNOSIS_BACKEND_URL=http://localhost:8000
DAILY_TALK_BACKEND_URL=http://localhost:8001

# 独立 ASR 服务地址（可选，若未启动会 fallback 到 diagnosis）
ASR_STANDALONE_URL=http://localhost:8002
